# Copy to .env and fill in what you need. Never commit a real .env.
# cp .env.example .env

# LLM provider: "mock" (default — offline, deterministic) or "azure".
LLM_PROVIDER=mock

# Azure OpenAI — only needed when LLM_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Vector store. The API uses Qdrant when reachable, and falls back to an
# in-memory vector store automatically (docker compose starts Qdrant).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=policy_clauses

# Triage policy (INR).
AUTO_APPROVE_LIMIT_INR=25000
ANOMALY_ROUTE_THRESHOLD=0.6
ANOMALY_LOW_THRESHOLD=0.3

# Server.
HOST=0.0.0.0
PORT=8000
